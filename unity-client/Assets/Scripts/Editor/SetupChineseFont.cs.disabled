// ============================================================
// SetupChineseFont.cs — 一键创建中文TMP字体，消除63条警告
// 使用: Tools → VeilLand → Setup Chinese Font
// ============================================================

using UnityEngine;
using UnityEditor;
using System.IO;
using System.Collections.Generic;
using TMPro;
using TMPro.EditorUtilities;

public class SetupChineseFont : EditorWindow
{
    [MenuItem("Tools/VeilLand/Setup Chinese Font")]
    public static void Setup()
    {
        // Find LiberationSans SDF (the default TMP font)
        string libSansPath = null;
        var guids = AssetDatabase.FindAssets("LiberationSans SDF t:TMP_FontAsset");
        foreach (var guid in guids)
        {
            var p = AssetDatabase.GUIDToAssetPath(guid);
            if (p.EndsWith(".asset") && !p.Contains("Fallback") && !p.Contains("Outline"))
            {
                libSansPath = p;
                break;
            }
        }

        TMP_FontAsset libSans = null;
        if (!string.IsNullOrEmpty(libSansPath))
            libSans = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(libSansPath);

        if (libSans == null)
        {
            Debug.LogWarning("[Font] LiberationSans SDF not found, creating standalone Chinese font");
        }

        // Find a Chinese-capable system font
        string fontPath = FindChineseFont();
        if (string.IsNullOrEmpty(fontPath))
        {
            Debug.LogError("[Font] No Chinese font found! Please install a Chinese font first.");
            EditorUtility.DisplayDialog("错误", "找不到中文字体！请安装微软雅黑或等线字体。", "确定");
            return;
        }

        Debug.Log($"[Font] Using system font: {fontPath}");

        // Create the font asset
        string savePath = "Assets/Fonts";
        if (!Directory.Exists(savePath))
            Directory.CreateDirectory(savePath);

        // Load as Unity Font first
        var unityFont = new Font(fontPath);
        if (unityFont == null)
        {
            Debug.LogError("[Font] Failed to load system font");
            return;
        }

        // Create TMP font asset from Unity Font
        var fontAsset = TMP_FontAsset.CreateFontAsset(
            unityFont,
            36,          // sampling point size
            9,           // atlas padding
            UnityEngine.TextCore.LowLevel.GlyphRenderMode.SDFAA,
            4096,        // atlas width
            4096,        // atlas height
            TMPro.AtlasPopulationMode.Dynamic
        );

        if (fontAsset == null)
        {
            Debug.LogError("[Font] Failed to create Chinese font asset");
            return;
        }

        fontAsset.name = "ChineseFont SDF";
        AssetDatabase.CreateAsset(fontAsset, $"{savePath}/ChineseFont SDF.asset");

        // Add as fallback to LiberationSans
        if (libSans != null)
        {
            var so = new SerializedObject(libSans);
            var fallbacks = so.FindProperty("m_FallbackFontAssetTable");
            if (fallbacks != null)
            {
                // Check if already added
                bool alreadyAdded = false;
                for (int i = 0; i < fallbacks.arraySize; i++)
                {
                    if (fallbacks.GetArrayElementAtIndex(i).objectReferenceValue == fontAsset)
                    {
                        alreadyAdded = true;
                        break;
                    }
                }
                if (!alreadyAdded)
                {
                    fallbacks.arraySize++;
                    fallbacks.GetArrayElementAtIndex(fallbacks.arraySize - 1).objectReferenceValue = fontAsset;
                    so.ApplyModifiedPropertiesWithoutUndo();
                    EditorUtility.SetDirty(libSans);
                }
            }
        }

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        Debug.Log($"[Font] ✅ Chinese font created: {savePath}/ChineseFont SDF.asset");
        EditorUtility.DisplayDialog("成功",
            $"中文字体已创建并设为LiberationSans的fallback！\n\n字体: {Path.GetFileName(fontPath)}\n保存位置: {savePath}/ChineseFont SDF.asset\n\n下次Play时中文方块就会消失了。", "好的");
    }

    static string FindChineseFont()
    {
        string[] candidates = {
            @"C:\Windows\Fonts\msyh.ttc",      // 微软雅黑
            @"C:\Windows\Fonts\msyhbd.ttc",    // 微软雅黑 Bold
            @"C:\Windows\Fonts\simsun.ttc",    // 宋体
            @"C:\Windows\Fonts\simhei.ttf",    // 黑体
            @"C:\Windows\Fonts\Deng.ttf",      // 等线
            @"C:\Windows\Fonts\Dengb.ttf",     // 等线 Bold
            @"C:\Windows\Fonts\msjh.ttc",      // 微软正黑体
            @"C:\Windows\Fonts\mingliu.ttc",   // 细明体
        };

        foreach (var f in candidates)
            if (File.Exists(f))
                return f;

        return null;
    }

}
